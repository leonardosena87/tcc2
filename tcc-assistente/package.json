{
  "name": "tcc-assistente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assistente local para Word, Revit e AutoCAD",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "certs": "office-addin-dev-certs install",
    "register": "office-addin-dev-settings register manifest.xml",
    "unregister": "office-addin-dev-settings unregister manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-dev-settings": "^3.0.0",
    "office-addin-manifest": "^2.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}
